# ===== 大模型接入配置 =====
# 复制本文件为 .env 并填写。harness 读取这些环境变量，无需改代码即可切换厂商。

# OpenAI 兼容接口的 base_url。务必保留各家要求的路径前缀
# （OpenAI/DeepSeek 用 /v1、智谱是 /v4、通义是 compatible-mode/v1），见文末对照表。
LLM_BASE_URL=https://api.openai.com/v1

# API Key（保命：不要把 .env 提交到 git，已在 .gitignore 中）
LLM_API_KEY=sk-xxxx

# 模型名
LLM_MODEL=gpt-4o-mini

# 可选：采样温度
# LLM_TEMPERATURE=0.7

# 可选：agent 单轮问题最多迭代步数（防止工具调用死循环），默认 8
# AGENT_MAX_ITERATIONS=8

# 可选：系统提示词
# SYSTEM_PROMPT=你是一个乐于助人的智能体，会使用工具完成用户的请求。

# 可选：多模型协作「主答 + 审查改进」（也可在 GUI 设置面板勾选，或 CLI 用 /collab on|off）
# COLLAB_ENABLED=0
# COLLAB_CRITIC_MODEL=deepseek-v4-flash   # 审查模型；留空=默认取该厂商的轻量模型

# ===== 上下文压缩（省 token；参考 headroom 的思路，默认开启）=====
# 长会话的历史随轮次无限增长、每轮把旧的工具输出全文重发是最主要的 token 开销。
# 本 harness 会在新一轮开始前检查估算 token：超过预算时，把"更早、已完成"的轮次折成
# 一条很短的「会话回顾」小结（免费确定性折叠，不额外调用模型），被折叠轮次的原文存入
# 会话内存档，模型需要精确细节时可调用 recall_history 工具检索（CCR：压缩-缓存-可检索）。
# 单轮内已发消息不会改写 → 请求前缀保持稳定，可命中 DeepSeek/通义/Kimi/GLM 等厂商的
# 自动前缀 KV 缓存（前缀相同部分按更低的缓存价计费）。
# CONTEXT_COMPRESS=1          # 总开关（0=完全关闭，回到"从不压缩"的行为）
# CONTEXT_COMPRESS_MID=1      # 单轮任务中途超预算时，也自动折叠更早的、已被模型消费的工具回合
#                            #（保留最近几个回合 + 正在进行的这步；折掉的原文进 recall 存档）
# CONTEXT_BUDGET_TOKENS=0     # 触发折叠的估算 token 上限；0=按模型窗口自动（约窗口 55%）
# CONTEXT_MODE=gist           # 小结生成方式；现实现 gist（免费确定性）；0 之外将来可扩展 model 摘要
# CONTEXT_RECALL=1            # 折叠后是否给模型注册 recall_history 工具（可取回折叠前原文）
# CONTEXT_KEEP_RECENT=1       # 保留最近几个"已完成"轮次/工具回合的全文不折叠

# ===== 常见厂商对照（任选一行替换上面的值） =====
# --- DeepSeek（V4 支持工具/多智能体协作） ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的deepseek密钥
# LLM_MODEL=deepseek-v4-pro      # 主答；审查/轻量用 deepseek-v4-flash

# --- 阿里通义千问（DashScope 兼容模式） ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-你的通义密钥
# LLM_MODEL=qwen-plus            # 或 qwen-max / qwen-turbo

# --- Kimi (Moonshot) ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-你的kimi密钥
# LLM_MODEL=moonshot-v1-8k

# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的glm密钥(不带sk-前缀)
# LLM_MODEL=glm-4-flash

# --- 本地 Ollama（OpenAI 兼容端口 11434，无需 api key） ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
